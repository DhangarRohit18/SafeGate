# ==============================================================
# Dwellora - Environment Configuration Template
# ==============================================================

# --------------------------------------------------------------
# 1. FRONTEND PUBLIC CONFIGURATION (Vite Client-Side)
# (Safe to expose to browser. Prefixed with VITE_)
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=dwellora-society.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dwellora-society
VITE_FIREBASE_STORAGE_BUCKET=dwellora-society.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_USE_FIREBASE_EMULATOR=false

# Razorpay PUBLIC Key ID only (Safe for browser checkout modal; NEVER put secret here)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Publicly hosted branding logo for Razorpay modal (MUST be https:// or left empty)
VITE_PUBLIC_LOGO_URL=

# Backend API URL (Express REST API)
VITE_BACKEND_URL=http://localhost:5000

# --------------------------------------------------------------
# 2. BACKEND SECRETS (Express Server & PostgreSQL ONLY)
# ⚠️ NEVER expose these in frontend code or commit to source control!
# --------------------------------------------------------------
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/dwellora_db?schema=public

# Razorpay Production / Test Credentials
# Server-side only: Used for HMAC-SHA256 signature verification, order creation, and refunds
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key_never_share
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret_never_share
